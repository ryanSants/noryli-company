# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA envie o arquivo ".env" para o GitHub — ele já está no .gitignore.

# --- Banco de dados e autenticação (Lovable Cloud / Supabase) ---
# Encontrados nas configurações do backend do projeto.
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_URL="https://sua-url-do-backend"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# Mesmas três variáveis com prefixo VITE_ (usadas pelo navegador):
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://sua-url-do-backend"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# Chave administrativa — SOMENTE no servidor, nunca no navegador.
# Necessária apenas se houver operações privilegiadas no servidor.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxx"

# URL de conexão usada apenas para aplicar migrações do banco (drizzle-kit).
LOVABLE_DB_MIGRATION_URL="postgresql://usuario:senha@host:5432/postgres"
